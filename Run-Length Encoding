If you need to, refresh your memory about run-length encoding.

Here is an example:

# encode ["a"; "a"; "a"; "a"; "b"; "c"; "c"; "a"; "a"; "d"; "e"; "e"; "e"; "e"];;
- : (int * string) list =
[(4, "a"); (1, "b"); (2, "c"); (2, "a"); (1, "d"); (4, "e")]

뭐가 몇번씩 나오는지 순서대로 적어야한다는 요구사항임.


해결하려면


let encode lst =
  (* aux는 재귀를 돌며 결과를 쌓아갈 내부 함수 *)
  (* count: 현재 연속된 요소의 개수, current: 현재 세고 있는 요소 *)
  let rec aux count current acc = function
    | [] -> 
        (* 리스트가 끝나면 마지막으로 세고 있던 그룹을 추가하고 결과를 뒤집어서 반환 *)
        (count, current) :: acc |> List.rev
    | x :: xs -> 
        if x = current then
          (* 같은 문자가 이어지면 카운트를 1 증가시킵니다. *)
          aux (count + 1) current acc xs
        else
          (* 새로운 문자가 등장하면, 기존에 세던 그룹을 acc에 넣고 새 문자를 세기 시작 *)
          aux 1 x ((count, current) :: acc) xs
  in
  match lst with
  | [] -> [] (* 빈 리스트가 들어오면 빈 리스트 반환 *)
  | x :: xs -> aux 1 x [] xs




