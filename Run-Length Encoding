--> "다음 함수의 인자로 보낼 줄안에서는 그런 순서 고려안해도 된다" 가 결론입니다.


여담이지만 OCaml은 새로운 인자들을 "오른쪽부터" 읽습니다.


공식 솔루션

let encode list = (* 인코드 list에 어떤 원소를 넣을것이냐 *)
    let rec aux count acc = function (* acc 안에는 뭘 넣을거냐 *)
      | [] -> [] (* Can only be reached if original list is empty *)
      | [x] -> (count + 1, x) :: acc
      | a :: (b :: _ as t) -> if a = b then aux (count + 1) acc t
                              else aux 0 ((count + 1, a) :: acc) t in
    List.rev (aux 0 [] list)
;;

결과는

val encode : 'a list -> (int * 'a) list = <fun>

그런데
| [x] -> (count + 1, x) :: acc 이거 좀 수상하지 않나;;

분명히 이런거 [_]로 뭐가오든 상관 안한다는 뉘앙스 내야할텐데 어째서 선언한적도 없는 x를 함부로 사용하는가?

여기서 내가 몰랐던건 _는 "정말 뭐가오든 신경 안써서 뒤에 전달도 제대로 할필요 없는" 상황에서만 써야한다는것이다. 

| [_] -> (count + 1, x) :: acc    (* 원소가 뭔지 알아내서 뒤에 "그 원소를~" 이라고 전달해야하지만 실패. 따라서 에러 발생 *)
그래서 _는 앞으로 "버린다" 라고 읽는게 좋다.

| [x] -> (count + 1, x) :: acc    (* 정상적으로 하나남은 이 x라는 원소를 갖다가 count는 1 올리고 그 x 넣어서 해당 리스트를 acc로 집어넣음 *)

| a :: (b :: _ as t) -> if a = b then aux (count + 1) acc t
                              else aux 0 ((count + 1, a) :: acc) t in

이건 a :: (b :: _ as t) 를 먼저 볼건데, 만약 ["a"; "b"; "c"]가 들어온다면 a엔 a가, b엔 b가, c는 버려진다.
그리고 as t가 작동하여 as t가 존재하는 이 ()를 t라고 부를 수 있게 된다. 즉 t = ["b"; "c"] 가 된것이다.

그후 if a = b then aux (count + 1) acc t
                              else aux 0 ((count + 1, a) :: acc) t in 로
만약 a랑 b가 같으면 count 하나 올리고 list에 꼬리 넣는 일을 하게된다.
만약 a랑 b가 다르면 count 초기화하고 이때까지한거 acc에 집어넣는다. list엔 여전히 꼬리 집어넣는다.

혹시 초기화가 아까는 1이었고 여기선 0인게 좀 거슬리지 않나?

(* 아까한거는 *)
match lst with
| [] -> []
| x :: xs -> aux 1 x [] xs  (* ← 첫 문자 x를 꺼내면서 시작하니까 시작 카운트를 '1'로 해주는거임 *)

즉 시작부터 문자 하나 까고 들어가니까 1로 시작해야하는거고

(* 지금 이거는 *)
List.rev (aux 0 [] list)    (* ← 아무것도 안 꺼내니까 일단 카운트 '0'으로 시작해야함 *)


또 else aux 0 ((count + 1, a) :: acc) t in 이것도 in << 이거 초면인데 뭘까?

let 임시_이름 = 값_또는_함수_정의 in 진짜_실행할_코드 로 작성된다는걸 유추해볼 수 있다.
즉 List.rev (aux 0 [] list) 이게 실행할 코드의 영역이다.

let encode list =
  
  ┌────────────────────────────────────────────────────────┐
  │ let rec aux count acc = function                        │
  │   | [] -> []                                           │
  │   | [x] -> (count + 1, x) :: acc                       │
  │   | a :: (b :: _ as t) -> if a = b then aux ... t      │
  │                           else aux 0 (...) t           │
  └────────────────────────────────────────────────────────┘
  in  (* ← 이 'in'은 이 aux 덩어리 전체의 경계에서 작동한다. *)

따라서 in으로 List.rev 가 작동하는건 =function list가 일이 다 끝나고 나서야 이뤄지는것이다.






솔루션 하나 더있다.

let pack list =
    let rec aux current acc = function
      | [] -> []    (* Can only be reached if original list is empty *)
      | [x] -> (x :: current) :: acc
      | a :: (b :: _ as t) ->
         if a = b then aux (a :: current) acc t
         else aux [] ((a :: current) :: acc) t  in
    List.rev (aux [] [] list)
;;

let encode list =
    List.map (fun l -> (List.length l, List.hd l)) (pack list)
;;

결과는

val pack : 'a list -> 'a list list = <fun>
val encode : 'a list -> (int * 'a) list = <fun>


라이브러리 함수 정리.
1. ⁠pack list⁠
 원본 리스트를 ⁠[ ["a"; "a"; "a"; "a"]; ["b"]; ["c"; "c"] ]⁠ 형태로 먼저 묶어오는 일을 한다.

2. ⁠List.map⁠ (변환기)
 리스트 안에 들어있는 원소들을 하나도 빠짐없이 내가 원하는 모양으로 일괄 변환해 주는 함수다.

 여기서는 ⁠pack⁠이 만들어준 상자들을 하나씩 꺼내서 ⁠fun l -> ...⁠ 이라는 변환 공식에 집어넣는다.

3. 변환 공식: ⁠(fun l -> (List.length l, List.hd l))⁠
여기서 ⁠l⁠은 ⁠pack⁠이 쪼개놓은 리스트 원소 하나(예: ⁠["a"; "a"; "a"; "a"]⁠)를 뜻한다. 이 원소 뭉탱이를 가지고 두 가지 정보를 알아낸다.
 ⁠List.length l⁠: 원소의 길이(원소의 원소 개수)를 센다. ⁠["a"; "a"; "a"; "a"]⁠이 들어오면 ⁠4⁠가 될것.
 ⁠List.hd l⁠: ⁠hd⁠는 Head인데, 리스트의 맨 첫 번째 원소 뭉탱이속 첫째 원소만을 의미한다. ⁠["a"; "a"; "a"; "a"]⁠ 중에서 맨앞 원소인 "a"⁠를 의미한다.

 결과: 이 두 개를 튜플로 묶어서 ⁠(4, "a")⁠로 변환한다.


⁠List.map⁠이 작동하는 과정을 정리하자면 이렇다.


1. ⁠pack list⁠ 의 작동.
 ["a"; "a"; "a"; "a"]⁠ , ["b"]⁠ , ["c"; "c"]⁠ 순서.
2. ⁠List.map⁠이 첫 번째 원소 뭉탱이 처리
 ⁠["a"; "a"; "a"; "a"]⁠ 의 길이는 ⁠4⁠, 머리는 ⁠"a"⁠ -> ⁠(4, "a")⁠ 로 변환
3. ⁠List.map⁠이 두 번째 원소 뭉탱이 처리
 ⁠["b"]⁠ 의 길이는 ⁠1⁠, 머리는 ⁠"b"⁠ -> ⁠(1, "b")⁠ 로 변환
4. ⁠List.map⁠이 세 번째 원소 뭉탱이 처리
 ⁠["c"; "c"]⁠ 의 길이는 ⁠2⁠, 머리는 ⁠"c"⁠ -> ⁠(2, "c")⁠ 로 변환
